    {
      "id": 14,
      "type": "table",
      "title": "Open dead letters",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hubdb"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hubdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.created_at AS \"time\", d.message_id AS \"message\", m.message_type AS \"type\", m.control_id AS \"control id\", d.stage, d.code, d.message\nFROM hub.dead_letter d JOIN hub.message m ON m.id = d.message_id\nWHERE d.replayed_at IS NULL ORDER BY d.id DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
