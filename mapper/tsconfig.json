{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The engine runs Rhino 1.7.13. Compiling to ES5 with only the ES5 standard
    // library makes the compiler reject any API Rhino does not have
    // (Object.assign, Array.prototype.find, Map, String.prototype.startsWith, ...).
    "target": "ES5",
    "lib": ["ES5"],
    "module": "CommonJS",
    "moduleResolution": "node10",
    "types": [],
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "build",
    "importHelpers": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
